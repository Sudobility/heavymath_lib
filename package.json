{
  "name": "@sudobility/heavymath_lib",
  "version": "0.0.96",
  "description": "Business logic library for Heavymath prediction market platform",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "bunx tsc -p tsconfig.build.json",
    "build:watch": "bunx tsc --watch",
    "clean": "rm -rf dist",
    "prepublishOnly": "bun run clean && bun run build",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "lint": "bunx eslint src --ext .ts,.tsx",
    "lint:fix": "bunx eslint src --ext .ts,.tsx --fix",
    "format": "bunx prettier --write src/**/*.ts",
    "format:check": "bunx prettier --check src/**/*.ts",
    "typecheck": "bunx tsc --noEmit",
    "verify": "bun run typecheck && bun run lint && bun run test:unit"
  },
  "keywords": [
    "heavymath",
    "prediction-market",
    "typescript",
    "business-logic",
    "react",
    "react-native"
  ],
  "author": "John Huang",
  "license": "BUSL-1.1",
  "peerDependencies": {
    "@sudobility/auctions_contracts": "^0.1.23",
    "@sudobility/heavymath_contracts": "^0.1.79",
    "@sudobility/heavymath_indexer_client": "^0.0.66",
    "@sudobility/heavymath_types": "^0.0.38",
    "@sudobility/types": "^1.9.75",
    "@tanstack/react-query": ">=5.0.0",
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@eslint/js": "~9.39.5",
    "@sudobility/auctions_contracts": "^0.1.23",
    "@sudobility/heavymath_contracts": "^0.1.79",
    "@sudobility/heavymath_indexer_client": "^0.0.66",
    "@sudobility/heavymath_types": "^0.0.38",
    "@sudobility/types": "^1.9.75",
    "@tanstack/react-query": "~5.104.5",
    "@testing-library/react": "~16.3.3",
    "@types/node": "~24.19.2",
    "@types/react": "~19.3.0",
    "@typescript-eslint/eslint-plugin": "~8.72.0",
    "@typescript-eslint/parser": "~8.72.0",
    "eslint": "~9.39.5",
    "eslint-config-prettier": "~10.1.8",
    "eslint-plugin-prettier": "~5.5.7",
    "eslint-plugin-react-hooks": "~7.1.1",
    "happy-dom": "~20.14.6",
    "prettier": "~3.9.10",
    "react": "~19.3.1",
    "typescript": "~5.9.3",
    "vitest": "~4.1.12"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Sudobility/heavymath_lib.git"
  }
}
